# Copy to .env.local and fill in. Only VITE_* vars reach the browser bundle.
#
# The publishable key is safe in the client: every table has RLS enabled and
# scoped to auth.uid(), so it can only ever read that user's own rows.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# NEVER put these here — a VITE_ prefix would inline them into the bundle,
# and even without it they do not belong in a client-side project.
# They are set as Supabase Edge Function secrets instead:
#
#   supabase secrets set GEMINI_API_KEY=AQ....
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
